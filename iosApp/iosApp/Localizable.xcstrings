            "state": "translated",
            "value": "Bazas · Ronda %lld"
          }
        }
      }
    },
    "Try again": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut versuchen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reintentar"
          }
        }
      }
    },
    "Undo last round": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzte Runde rückgängig"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deshacer la última ronda"
          }
        }
      }
    },
    "Undo the last round?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzte Runde rückgängig machen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Deshacer la última ronda?"
          }
        }
      }
    },
    "Until someone reaches 100 points": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis jemand 100 Punkte erreicht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta que alguien llegue a 100 puntos"
          }
        }
      }
    },
    "Updated games: %lld": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisierte Spiele: %lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Partidas actualizadas: %lld"
          }
        }
      }
    },
    "Use this when the same person was added twice, for example on two devices. Players who played in the same game can't be merged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze das, wenn dieselbe Person doppelt angelegt wurde, zum Beispiel auf zwei Geräten. Spieler aus demselben Spiel können nicht zusammengeführt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Úsalo cuando la misma persona se añadió dos veces, por ejemplo en dos dispositivos. No se pueden fusionar jugadores que jugaron la misma partida."
          }
        }
      }
    },
    "Username": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzername"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre de usuario"
          }
        }
      }
    },
    "What changes": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was sich ändert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué cambia"
          }
        }
      }
    },
    "Who's playing? (%lld–%lld players)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer spielt mit? (%lld–%lld Spieler)"
          }
        },
        "en": {
          "stringUnit": {
