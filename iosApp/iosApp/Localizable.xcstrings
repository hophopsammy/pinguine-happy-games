    "Start fresh": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neu beginnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar de cero"
          }
        }
      }
    },
    "Start with empty data?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit leeren Daten beginnen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Empezar sin datos?"
          }
        }
      }
    },
    "Statistics": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistik"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estadísticas"
          }
        }
      }
    },
    "Statistics appear once a game is finished.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Statistik erscheint, sobald ein Spiel beendet ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estadísticas aparecen cuando termina una partida."
          }
        }
      }
    },
    "Sync": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizar"
          }
        }
      }
    },
    "Tap the flag of the player who ended the round. Their points are doubled if they are positive and someone else has the same or fewer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf die Fahne bei der Person, die die Runde beendet hat. Ihre Punkte werden verdoppelt, wenn sie positiv sind und jemand gleich viele oder weniger Punkte hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la bandera de quien terminó la ronda. Sus puntos se duplican si son positivos y otra persona tiene los mismos o menos."
          }
        }
      }
    },
    "The best final score: lowest for Skyjo and Biberbande, highest for Wizard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das beste Endergebnis: das niedrigste bei Skyjo und Biberbande, das höchste bei Wizard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mejor puntuación final: la más baja en Skyjo y Biberbande, la más alta en Wizard."
          }
        }
      }
    },
    "The current totals decide the winner.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle Punktestand entscheidet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide la puntuación actual."
          }
        }
      }
    },
    "The data file couldn't be read. It hasn't been changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datendatei konnte nicht gelesen werden. Sie wurde nicht verändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el archivo de datos. No se ha modificado."
          }
        }
      }
    },
    "The game is removed and no longer counts for the statistics.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spiel wird entfernt und zählt nicht mehr für die Statistik."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La partida se elimina y deja de contar en las estadísticas."
          }
        }
      }
    },
    "The last round's scores are removed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Punkte der letzten Runde werden entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan los puntos de la última ronda."
          }
        }
      }
    },
    "The same players can join every game. Their username is how your devices recognise them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieselben Spieler können bei jedem Spiel mitmachen. Am Benutzernamen erkennen deine Geräte sie wieder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mismos jugadores pueden unirse a cualquier juego. Tus dispositivos los reconocen por su nombre de usuario."
          }
        }
      }
    },
    "The tricks add up to %lld, but this round needs %lld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stiche ergeben %lld, diese Runde braucht aber %lld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The tricks add up to %1$lld, but this round needs %2$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las bazas suman %lld, pero esta ronda necesita %lld."
          }
        }
      }
    },
    "The unreadable file is kept on the device. You can bring your games back by importing a backup file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die unlesbare Datei bleibt auf dem Gerät. Deine Spiele kannst du zurückholen, indem du eine Sicherungsdatei importierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo ilegible se conserva en el dispositivo. Puedes recuperar tus partidas importando una copia de seguridad."
          }
        }
      }
    },
    "The username identifies the player when importing data from another device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Benutzernamen wird der Spieler beim Importieren von einem anderen Gerät erkannt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre de usuario identifica al jugador al importar datos de otro dispositivo."
          }
        }
      }
    },
    "This file is damaged: some games refer to players that aren't in it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist beschädigt: Einige Spiele verweisen auf Spieler, die fehlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo está dañado: algunas partidas hacen referencia a jugadores que no están."
          }
        }
      }
    },
    "This file was made by a newer version of the app. Update the app and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei stammt von einer neueren App-Version. Aktualisiere die App und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo es de una versión más nueva de la app. Actualiza la app y vuelve a intentarlo."
          }
        }
      }
    },
    "This game was deleted": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Spiel wurde gelöscht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta partida se eliminó"
          }
        }
      }
    },
    "This isn't a Pinguine Spiele backup file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist keine Sicherungsdatei von Pinguine Spiele."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no es una copia de Pinguine Spiele."
          }
        }
      }
    },
    "This username is already taken.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Benutzername ist schon vergeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese nombre de usuario ya existe."
          }
        }
      }
    },
    "To bring another device up to date, export here and import the .pinguine file there, for example with AirDrop. Importing adds its games to yours and matches players by username. The file also works as a backup.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ein anderes Gerät auf den neuesten Stand zu bringen, exportiere hier und importiere die .pinguine-Datei dort, zum Beispiel per AirDrop. Beim Importieren kommen ihre Spiele zu deinen dazu und Spieler werden über den Benutzernamen erkannt. Die Datei dient auch als Sicherung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para poner al día otro dispositivo, exporta aquí e importa el archivo .pinguine allí, por ejemplo con AirDrop. Al importarlo, sus partidas se suman a las tuyas y los jugadores se reconocen por su nombre de usuario. El archivo también sirve como copia de seguridad."
          }
        }
      }
    },
    "Total": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesamt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Total"
          }
        }
      }
    },
    "Total so far: %lld": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisher: %lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta ahora: %lld"
          }
        }
      }
    },
    "Tricks don't add up": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stiche gehen nicht auf"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las bazas no cuadran"
          }
        }
      }
    },
    "Tricks entered: %lld of %lld": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingetragene Stiche: %lld von %lld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Tricks entered: %1$lld of %2$lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazas anotadas: %lld de %lld"
          }
        }
      }
    },
    "Tricks · Round %lld": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiche · Runde %lld"
          }
        },
        "es": {
