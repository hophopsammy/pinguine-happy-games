{
  "sourceLanguage": "en",
  "strings": {
    "%@ and %@ stay separate players because they played together.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ und %@ bleiben getrennte Spieler, weil sie zusammen gespielt haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ and %2$@ stay separate players because they played together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ y %@ siguen siendo jugadores distintos porque jugaron juntos."
          }
        }
      }
    },
    "%@ ended the round": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat die Runde beendet"
          }
