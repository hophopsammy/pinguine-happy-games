    "Drag to match the table. The first seat deals the first round, then the deal moves on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe die Namen in die Sitzordnung am Tisch. Der erste Platz gibt in der ersten Runde, danach wechselt der Geber."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para imitar la mesa. El primer puesto reparte la primera ronda y luego se turna."
          }
        }
      }
    },
    "Drag to match the table. This is also the order of the columns.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe die Namen in die Sitzordnung am Tisch. In dieser Reihenfolge stehen auch die Spalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para imitar la mesa. Es también el orden de las columnas."
          }
        }
      }
    },
