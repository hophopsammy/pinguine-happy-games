            "value": "Who's playing? (%1$lld–%2$lld players)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quién juega? (%lld–%lld jugadores)"
          }
        }
      }
    },
    "Winner": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewinner"
          }
        },
        "es": {
          "stringUnit": {
