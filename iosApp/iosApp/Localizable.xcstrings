          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Victorias"
          }
        }
      }
    },
    "Your last change may not be saved. Try again or free up some storage.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine letzte Änderung wurde eventuell nicht gesichert. Versuche es erneut oder schaffe Speicherplatz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que tu último cambio no se haya guardado. Inténtalo de nuevo o libera espacio."
          }
        }
      }
    },
    "· Tricks won:": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "· Gewonnene Stiche:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "· Bazas ganadas:"
          }
        }
